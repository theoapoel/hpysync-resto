APP_NAME="HPYSync Resto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# If this app is served from a subfolder (e.g. XAMPP htdocs without a vhost,
# so the real URL is http://localhost/resto-pos/public), set BOTH of these
# to that full URL — not just APP_URL. Vite's built JS/CSS chunk URLs come
# from ASSET_URL specifically (baked in at `npm run build` time), not from
# request-time route()/asset() resolution, so leaving it unset serves every
# chunk from the domain root and 404s. Example for a root-domain deploy:
# APP_URL=http://localhost:8000 (leave ASSET_URL unset)
APP_URL=http://localhost:8000
# ASSET_URL=http://localhost/resto-pos/public

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=larapos
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120


# ERPNext Configuration
ERPNEXT_URL=http://your-erpnext-url
ERPNEXT_API_KEY=your_api_key
ERPNEXT_API_SECRET=your_api_secret
ERPNEXT_COMPANY=Your Company Name
ERPNEXT_POS_PROFILE=Your POS Profile

# ===== Backup Otomatis (spatie/laravel-backup) =====
BACKUP_DISK=google
BACKUP_NOTIFICATION_EMAIL=admin@example.com
# Password enkripsi arsip zip backup (opsional tapi disarankan). Kosongkan untuk tanpa enkripsi.
BACKUP_ARCHIVE_PASSWORD=
# Path folder mysqldump (XAMPP). Ubah bila instalasi berbeda.
DB_DUMP_BINARY_PATH="C:\xampp\mysql\bin"

# ===== Google Drive (tujuan backup) =====
# Cara A (disarankan): service account — isi path ke file JSON, taruh DI LUAR git.
GOOGLE_DRIVE_SERVICE_ACCOUNT="C:\secure\hpy-drive-service-account.json"
# Cara B: OAuth (client id/secret + refresh token). Kosongkan bila pakai service account.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# ID folder Google Drive tujuan (ambil dari URL folder). Wajib untuk service account.
GOOGLE_DRIVE_FOLDER_ID=
